{
    "name": "pl_validate_landing_files",
    "properties": {
        "activities": [
            {
                "name": "Set _v_ingest_date",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "v_ingest_date",
                    "value": {
                        "value": "@if(\n    or(\n        equals(pipeline().parameters.p_ingest_date, ''),\n        equals(pipeline().parameters.p_ingest_date, null)\n    ),\n    formatDateTime(utcNow(), 'yyyy-MM-dd'),\n    pipeline().parameters.p_ingest_date\n)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "getmeta_sensor_readings_file",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "Set _v_ingest_date",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_adls_binary_file_param",
                        "type": "DatasetReference",
                        "parameters": {
                            "p_file_system": {
                                "value": "@pipeline().parameters.p_file_system",
                                "type": "Expression"
                            },
                            "p_directory": "@concat('landing/sensor_readings/ingest_date=', variables('v_ingest_date'))",
                            "p_file_name": {
                                "value": "data.txt.gz",
                                "type": "Expression"
                            }
                        }
                    },
                    "fieldList": [
                        "exists",
                        "itemName",
                        "lastModified",
                        "size"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "getmeta_sensor_metadata_file",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "getmeta_sensor_readings_file",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_adls_binary_file_param",
                        "type": "DatasetReference",
                        "parameters": {
                            "p_file_system": {
                                "value": "@pipeline().parameters.p_file_system",
                                "type": "Expression"
                            },
                            "p_directory": {
                                "value": "@concat('landing/sensor_metadata/ingest_date=', variables('v_ingest_date'))",
                                "type": "Expression"
                            },
                            "p_file_name": "mote_locs.txt"
                        }
                    },
                    "fieldList": [
                        "exists",
                        "itemName",
                        "lastModified",
                        "size"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "if_landing_files_are_valid",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "getmeta_sensor_metadata_file",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@and(\n    and(\n        equals(activity('getmeta_sensor_readings_file').output.exists, true),\n        greater(activity('getmeta_sensor_readings_file').output.size, 0)\n    ),\n    and(\n        equals(activity('getmeta_sensor_metadata_file').output.exists, true),\n        greater(activity('getmeta_sensor_metadata_file').output.size, 0)\n    )\n)",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [
                        {
                            "name": "fail_landing_validation",
                            "type": "Fail",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "message": {
                                    "value": "@concat(     'Landing validation failed for ingest_date=',     variables('v_ingest_date'),     '. sensor_readings exists=',     string(activity('getmeta_sensor_readings_file').output.exists),     ', sensor_readings size=',     string(activity('getmeta_sensor_readings_file').output.size),     ', sensor_metadata exists=',     string(activity('getmeta_sensor_metadata_file').output.exists),     ', sensor_metadata size=',     string(activity('getmeta_sensor_metadata_file').output.size) )",
                                    "type": "Expression"
                                },
                                "errorCode": "LANDING_VALIDATION_FAILED"
                            }
                        }
                    ],
                    "ifTrueActivities": [
                        {
                            "name": "wait_validation_success",
                            "type": "Wait",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "waitTimeInSeconds": 1
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "p_ingest_date": {
                "type": "string"
            },
            "p_file_system": {
                "type": "string",
                "defaultValue": "iot-berkeley-lab"
            }
        },
        "variables": {
            "v_ingest_date": {
                "type": "String"
            }
        },
        "annotations": [],
        "lastPublishTime": "2026-06-10T18:19:21Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}